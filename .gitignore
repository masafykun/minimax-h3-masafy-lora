.DS_Store
.env
.venv/
__pycache__/
*.pyc
*.log

# 学習画像とキャプションは公開する（本人の判断、2026-08-15）。
# LoRAの重みは容量の都合で Hugging Face 側に置く。
*.safetensors

# 検証動画は小さいので同梱する（論文のアブレーションの根拠）
!samples/*.mp4
output/
output/*
!output/.gitkeep
status/*
!status/.gitkeep
records/*.json
records/*.csv

# Local credentials must remain outside Git.
.runpod-token
*.pem
*.key
id_*

# LaTeX の中間ファイル（PDFとtexのみ追跡する）
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
